{
  "name": "mb-factory",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @mb-factory/console dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm test:hooks && pnpm test:visual",
    "test:hooks": "bash plugin/hooks/test.sh",
    "test:visual": "bash .github/scripts/visual.test.sh",
    "type-check": "pnpm -r type-check",
    "lint:biome": "biome check .",
    "lint": "pnpm lint:biome && pnpm type-check",
    "format": "biome check --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^24.19.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  }
}
