{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- . ../../packages ../../projects ../../package.json ../../pnpm-lock.yaml ../../pnpm-workspace.yaml",
  "functions": {
    "app/api/scheduler/wake/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "scheduler-wake",
          "retryAfterSeconds": 60
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/scheduler/cron",
      "schedule": "17 6 * * *"
    }
  ]
}
